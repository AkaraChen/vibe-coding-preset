{
  "name": "vibe-coding-preset",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "check": "pnpm format:check && pnpm lint:eslint && pnpm lint:biome && pnpm lint:oxlint && pnpm typecheck && pnpm test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:biome": "biome lint . --error-on-warnings",
    "lint:oxlint": "oxlint . --deny-warnings --report-unused-disable-directives",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "workboard:check": "pnpm --filter workboard-guarded check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@eslint/js": "10.0.1",
    "@vibe-coding-preset/biome-config": "workspace:*",
    "@vibe-coding-preset/eslint-config": "workspace:*",
    "@vibe-coding-preset/oxlint-config": "workspace:*",
    "eslint": "10.9.0",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "5.9.3"
  }
}
