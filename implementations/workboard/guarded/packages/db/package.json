{
  "name": "@workboard/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "migrate": "node --import tsx src/migrate.ts",
    "seed": "node --import tsx src/seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@workboard/shared": "workspace:*",
    "argon2": "0.44.0",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.7"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.8",
    "tsx": "4.20.6"
  }
}
