{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "extends": ["@vibe-coding-preset/biome-config/type-aware"],
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/dist",
      "!**/coverage",
      "!**/playwright-report",
      "!**/test-results",
      "!packages/db/drizzle",
      "!data"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "domains": {
      "react": "recommended",
      "types": "recommended"
    },
    "rules": {
      "correctness": {
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error"
      }
    }
  }
}
