{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "extends": ["./strict.jsonc"],
  "linter": {
    "domains": {
      "react": "recommended"
    },
    "rules": {
      "correctness": {
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error"
      }
    }
  }
}
